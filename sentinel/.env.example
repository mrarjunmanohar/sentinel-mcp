# Shopify AI Sentinel Configuration
SHOPIFY_SHOP=mystore.myshopify.com
SHOPIFY_TOKEN=your_shopify_admin_api_token
SHOPIFY_API_VERSION=2026-01

# Per-store tokens (for multi-store mode via stores.json)
# Format: SHOPIFY_TOKEN_{STORE_SLUG_UPPERCASE}
# SHOPIFY_TOKEN_MYSTORE=shpat_xxxx
# SHOPIFY_TOKEN_SECONDSTORE=shpat_yyyy

# LLM API key (CLI/dev path only — not needed for the MCP server,
# where Claude Desktop does the analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Report recipients (surfaced to Claude so it knows whom to address drafts to)
EMAIL_RECIPIENTS=sid@example.com

# Alert Settings
ALERT_SENSITIVITY=MED

# Database
DB_PATH=sentinel/data/sentinel.db
